{
  "name": "nexasoft-progresive-web-app",
  "description": "NexaSoft professional solutions, el futuro en soluciones de software.",
  "keywords": [
    "software development",
    "professional solutions",
    "web pages",
    "web sites",
    "mobile apps"
  ],
  "type": "module",
  "author": "Nexasoft SAS",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "trustedDependencies": [
    "sharp"
  ],
  "trustedDependencies-annotation": "Needed for bun to allow running install scripts",
  "packageManager": "pnpm@11.24.0",
  "private": true,
  "scripts": {
    "build": "pnpm run build.client && pnpm run build.server",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/static/vite.config.ts & qwik-city-static",
    "build.types": "tsc --incremental --noEmit",
    "buildserver2": "vite build -c adapters/static/vite.config.ts",
    "deploy": "netlify deploy --build",
    "deploy2": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "prefmt": "pnpm exec prettier . --write",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@builder.io/qwik-react": "0.5.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@modular-forms/qwik": "^0.29.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@netlify/edge-functions": "^3.0.8",
    "@qwik.dev/partytown": "^0.14.3",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-swipeable-views": "^0.13.6",
    "@types/react-swipeable-views-utils": "^0.13.7",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-plugin-qwik": "^1.20.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.11.0",
    "netlify-cli": "^26.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-swipeable-views": "^0.14.2",
    "react-swipeable-views-utils": "^0.14.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "undici": "^8.10.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.4",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  }
}
